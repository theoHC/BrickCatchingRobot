<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="turtlebot">
    <xacro:include filename="usefulstuff.xacro" />

    <xacro:property name="platform_height" value="1" />
    <xacro:property name="platform_radius" value="1" />
    <xacro:property name="wheel_radius" value="0.5" />

    <link name="world"></link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="world"/>
        <child link="base_link"/>        
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="1 1 .5" />
            </geometry>
            <material name="cyan"/>
        </visual>
    </link>

    <joint name="pillar_joint" type="fixed">
        <origin xyz="0 0 .25" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="pillar_link"/>        
    </joint>

    <link name="pillar_link">
        <visual>
            <origin xyz="0 0 ${platform_height / 2}" rpy="0 0 0"/>
            <geometry>
                <cylinder length="${platform_height}" radius="0.1" />
            </geometry>
            <material name="grey"/>
        </visual>
    </link>

    <joint name="platform_joint" type="revolute">
        <origin xyz="0 0 ${platform_height + .05}" rpy="0 0 0"/>
        <parent link="pillar_link"/>
        <child link="platform_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="${pi/4}" velocity="100" effort="100"/>
    </joint>

    <link name="platform_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <cylinder length=".1" radius="${platform_radius}" />
        </geometry>
        <material name="yellow"/>
    </visual>
    </link>
    <!-- <joint name="stem_joint" type="revolute">
        <origin xyz="0 0 -.25" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="stem_link"/>
        <axis xyz="0 0 1"/>   
    </joint>

    <link name="stem_link">
        <visual>
            <origin xyz="0 0 -.25" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder length=".2" radius="0.1" />
            </geometry>
            <material name="purple"/>
        </visual>
    </link> -->

</robot>