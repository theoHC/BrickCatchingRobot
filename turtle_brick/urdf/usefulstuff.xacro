<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Specify some colours -->

    <material name="grey">
        <color rgba=".6 .6 .6 1"/>
    </material>

    <material name="cyan">
        <color rgba="0 1 1 1"/>
    </material>

    <material name="yellow">
        <color rgba="1 1 0 1"/>
    </material>

    <material name="purple">
        <color rgba="1 0 1 1"/>
    </material>
</robot>