    <child link="platform_link"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0" upper="0.7853981633974483" velocity="100"/>
  </joint>
  <link name="platform_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length=".1" radius="1"/>
      </geometry>
      <material name="yellow"/>
    </visual>
  </link>
