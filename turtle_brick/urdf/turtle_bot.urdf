  <!-- Specify some colours -->
  <material name="grey">
    <color rgba=".6 .6 .6 1"/>
  </material>
  <material name="cyan">
    <color rgba="0 1 1 1"/>
  </material>
  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>
  <material name="purple">
    <color rgba="1 0 1 1"/>
  </material>
  <link name="world"/>
  <joint name="base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
