  </joint>
  <link name="pillar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.5"/>
      <geometry>
        <cylinder length="1" radius="0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="platform_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 1.05"/>
